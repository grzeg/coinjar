{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/app",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["dom"],
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "vite/client",
      "vitest/importMeta"
    ],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../libs/shared/util/tsconfig.lib.json"
    },
    {
      "path": "../../libs/budget/feature-yearly/tsconfig.lib.json"
    },
    {
      "path": "../../libs/budget/feature-transactions/tsconfig.lib.json"
    },
    {
      "path": "../../libs/budget/feature-plan/tsconfig.lib.json"
    },
    {
      "path": "../../libs/budget/feature-dashboard/tsconfig.lib.json"
    },
    {
      "path": "../../libs/budget/feature-daily-grid/tsconfig.lib.json"
    },
    {
      "path": "../../libs/budget/feature-categories/tsconfig.lib.json"
    }
  ]
}
