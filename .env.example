# Copy to .env.local for local development. Never commit .env.local.
# Everything prefixed VITE_ ends up in the public bundle: never put secrets here.

# Mock backend (MSW) in the browser.
VITE_ENABLE_MSW=true
# Random API errors to practise error states.
VITE_API_CHAOS=false

# CloudWatch RUM (production only; leave empty locally).
VITE_RUM_APP_MONITOR_ID=
VITE_RUM_IDENTITY_POOL_ID=
VITE_RUM_REGION=

# Optional; defaults to VERCEL_GIT_COMMIT_SHA on Vercel, "dev" locally.
# VITE_APP_VERSION=
